# Neon Postgres connection string (London region). Required at build time
# (for `payload migrate` / local dev) and as a server env var in production.
DATABASE_URI=postgres://user:password@host.neon.tech/dbname?sslmode=require

# Long random string. Required as a GitHub secret AND a server env var.
PAYLOAD_SECRET=

# Build-time only — NEXT_PUBLIC_* values are inlined during `next build`.
# Setting this on the server instead of in CI is a silent no-op.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Absolute path outside the release tree. On Hostinger this is
# /home/u569027851/data/media, symlinked into each release by deploy.yml.
# Do not derive this from __dirname — see IMPLEMENTATION_BRIEF.md §8.
UPLOADS_DIR=./data/media
